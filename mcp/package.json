{
  "name": "rex-crm-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing Rex CRM to Claude (Claude Code, Claude Desktop) through the CRM's REST API",
  "type": "module",
  "bin": {
    "rex-crm-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
