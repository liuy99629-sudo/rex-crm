# Optional overrides for docker compose (copy to .env). Defaults work out of the box.
# DB_PASSWORD=secret
# APP_KEY=base64:...   # generate: docker compose run --rm api php artisan key:generate --show
# Token for the local email lead pipeline (docker compose --profile aws up -d). Create it with:
#   docker compose exec api php artisan rex:integration-token lead-pipeline
# LEAD_PIPELINE_TOKEN=
# Analytics job outputs (docker compose --profile analytics run --rm analytics). Add ",snowflake"
# and the SNOWFLAKE_* values to also load the marts into Snowflake.
# ANALYTICS_SINKS=postgres,parquet
# SNOWFLAKE_ACCOUNT=  SNOWFLAKE_USER=  SNOWFLAKE_PASSWORD=  SNOWFLAKE_WAREHOUSE=  SNOWFLAKE_DATABASE=  SNOWFLAKE_SCHEMA=
