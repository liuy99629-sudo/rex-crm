APP_NAME="Rex CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# PostgreSQL (docker compose service name: postgres)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=rexcrm
DB_USERNAME=rexcrm
DB_PASSWORD=secret

# Redis: cache + queue (docker compose service name: redis)
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array

# Comma separated origins allowed to call the API directly (the web container proxies /api so usually not needed)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
