# Same line endings on every computer: files run inside Linux containers (PHP, Python, nginx
# templates, YAML) must stay LF even when the repo is cloned on Windows with core.autocrlf=true.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.parquet binary
*.jar binary
